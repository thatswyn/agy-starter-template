# ==============================================================================
# Variables de entorno del proyecto
# ==============================================================================
# Copia este archivo a .env y rellena tus credenciales reales:
#   cp .env.example .env
# NUNCA hagas commit del archivo .env con tokens o credenciales reales.
# ==============================================================================

# Antigravity / Google Gemini API (requerido para SDK y GitHub Actions)
GEMINI_API_KEY=

# GitHub (requerido para servidor MCP de GitHub y comandos con `gh`)
GITHUB_TOKEN=

# Servidores MCP opcionales (descomenta según lo que actives en .mcp.json)
# LINEAR_API_KEY=
# SENTRY_AUTH_TOKEN=
# NOTION_API_KEY=
# DATABASE_URL=postgresql://usuario:password@localhost:5432/mi_db
